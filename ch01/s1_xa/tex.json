 "q4": "AB = AC,\\ A \\ne O \\ \\overset{?}{\\Longrightarrow}\\ B = C",
 "q4c": "\\begin{bmatrix} 1 & 0 \\\\ 0 & 0 \\end{bmatrix}\\begin{bmatrix} 1 & 2 \\\\ \\color{#E8577A}{3} & \\color{#E8577A}{4} \\end{bmatrix} = \\begin{bmatrix} 1 & 0 \\\\ 0 & 0 \\end{bmatrix}\\begin{bmatrix} 1 & 2 \\\\ \\color{#E8577A}{5} & \\color{#E8577A}{6} \\end{bmatrix} = \\begin{bmatrix} 1 & 2 \\\\ 0 & 0 \\end{bmatrix}",
 "q4k": "A^{-1}AB = A^{-1}AC \\;\\Rightarrow\\; B = C",
