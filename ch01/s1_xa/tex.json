 "q5d": "BA = \\begin{bmatrix} 1 & 0 \\\\ 0 & 0 \\end{bmatrix}\\begin{bmatrix} 0 & 1 \\\\ 0 & 0 \\end{bmatrix} = \\color{#E8577A}{\\begin{bmatrix} 0 & 1 \\\\ 0 & 0 \\end{bmatrix}} \\ne O",
 "q6": "A = A^{-1} \\ \\overset{?}{\\Longrightarrow}\\ A = \\pm I",
