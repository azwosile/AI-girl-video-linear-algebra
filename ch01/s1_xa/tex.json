 "q9": "A = \\mathbf{x}\\mathbf{y}^T \\ \\overset{?}{\\Longrightarrow}\\ \\text{exactly one nonzero row}",
 "q9c": "\\begin{bmatrix} 12 & 20 & 8 \\\\ 3 & 5 & 2 \\\\ 9 & 15 & 6 \\end{bmatrix} \\to \\begin{bmatrix} 1 & \\frac53 & \\frac23 \\\\ \\color{#E8577A}{0} & \\color{#E8577A}{0} & \\color{#E8577A}{0} \\\\ \\color{#E8577A}{0} & \\color{#E8577A}{0} & \\color{#E8577A}{0} \\end{bmatrix}",
 "law": "AB \\ne BA, \\qquad AB = AC \\;\\not\\Rightarrow\\; B = C",
