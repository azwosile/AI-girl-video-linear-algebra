{
 "adjdef": "\\operatorname{adj} A = \\begin{bmatrix} A_{11} & A_{21} & \\cdots & A_{n1} \\\\ A_{12} & A_{22} & \\cdots & A_{n2} \\\\ \\vdots & & & \\vdots \\\\ A_{1n} & A_{2n} & \\cdots & A_{nn} \\end{bmatrix}",
 "ij": "(\\operatorname{adj} A)_{ij} = A_{ji}",
 "prod": "(A \\operatorname{adj} A)_{ij} = a_{i1}A_{j1} + a_{i2}A_{j2} + \\cdots + a_{in}A_{jn}",
 "cases": "= \\begin{cases} \\det(A) & i = j \\\\ 0 & i \\neq j \\end{cases}",
 "AadjI": "A\\,\\operatorname{adj} A = \\det(A)\\, I",
 "inv": "A^{-1} = \\frac{1}{\\det(A)} \\operatorname{adj} A",
 "adj2": "\\operatorname{adj}\\begin{bmatrix} \\class{m}{a} & \\class{s}{b} \\\\ \\class{s}{c} & \\class{m}{d} \\end{bmatrix} = \\begin{bmatrix} \\class{m}{d} & \\class{s}{-b} \\\\ \\class{s}{-c} & \\class{m}{a} \\end{bmatrix}",
 "inv2": "\\begin{bmatrix} 3 & 1 \\\\ 1 & 2 \\end{bmatrix}^{-1} = \\frac{1}{5}\\begin{bmatrix} 2 & -1 \\\\ -1 & 3 \\end{bmatrix}",
 "Aex": "A = \\begin{bmatrix} 2 & 1 & 2 \\\\ 3 & 2 & 2 \\\\ 1 & 2 & 3 \\end{bmatrix}",
 "cofM": "\\begin{bmatrix} \\class{a}{2} & \\class{a}{-7} & \\class{a}{4} \\\\ \\class{b}{1} & \\class{b}{4} & \\class{b}{-3} \\\\ \\class{c}{-2} & \\class{c}{2} & \\class{c}{1} \\end{bmatrix}",
 "adjM": "\\operatorname{adj} A = \\begin{bmatrix} \\class{a}{2} & \\class{b}{1} & \\class{c}{-2} \\\\ \\class{a}{-7} & \\class{b}{4} & \\class{c}{2} \\\\ \\class{a}{4} & \\class{b}{-3} & \\class{c}{1} \\end{bmatrix}",
 "invM": "A^{-1} = \\frac{1}{5}\\begin{bmatrix} 2 & 1 & -2 \\\\ -7 & 4 & 2 \\\\ 4 & -3 & 1 \\end{bmatrix}",
 "cram": "x_i = \\frac{\\det(A_i)}{\\det(A)}",
 "Ai": "A_i = \\big[\\, \\mathbf{a}_1 \\cdots \\class{b}{\\mathbf{b}} \\cdots \\mathbf{a}_n \\,\\big]",
 "cpf": "x_i = \\frac{b_1A_{1i} + b_2A_{2i} + \\cdots + b_nA_{ni}}{\\det(A)} = \\frac{\\det(A_i)}{\\det(A)}",
 "sys": "\\begin{aligned} x_1 + 2x_2 + x_3 &= 5 \\\\ 2x_1 + 2x_2 + x_3 &= 6 \\\\ x_1 + 2x_2 + 3x_3 &= 9 \\end{aligned}",
 "c1": "\\det(A_1) = \\begin{vmatrix} \\class{b}{5} & 2 & 1 \\\\ \\class{b}{6} & 2 & 1 \\\\ \\class{b}{9} & 2 & 3 \\end{vmatrix} = -4",
 "c2": "\\det(A_2) = \\begin{vmatrix} 1 & \\class{b}{5} & 1 \\\\ 2 & \\class{b}{6} & 1 \\\\ 1 & \\class{b}{9} & 3 \\end{vmatrix} = -4",
 "c3": "\\det(A_3) = \\begin{vmatrix} 1 & 2 & \\class{b}{5} \\\\ 2 & 2 & \\class{b}{6} \\\\ 1 & 2 & \\class{b}{9} \\end{vmatrix} = -8",
 "cdA": "\\det(A) = -4",
 "cx": "\\mathbf{x} = \\left(\\tfrac{-4}{-4},\\ \\tfrac{-4}{-4},\\ \\tfrac{-8}{-4}\\right) = (1,\\ 1,\\ 2)",
 "G": "A = \\begin{bmatrix} 2 & -1 \\\\ 0 & 1 \\end{bmatrix},\\quad \\mathbf{b} = \\begin{bmatrix} 4 \\\\ 2 \\end{bmatrix}",
 "gy": "y = \\frac{\\det(A_2)}{\\det(A)} = \\frac{\\begin{vmatrix} 2 & \\class{b}{4} \\\\ 0 & \\class{b}{2} \\end{vmatrix}}{2} = \\frac{4}{2} = 2",
 "gyA": "\\text{area} = y \\cdot \\det(A)",
 "tjA": "AA^{*} = A^{*}A = |A|\\,E",
 "tjH": "A\\mathbf{x} = \\mathbf{0} \\text{ has } \\mathbf{x} \\neq \\mathbf{0} \\;\\Rightarrow\\; |A| = 0"
}